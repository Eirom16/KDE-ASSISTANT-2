+#!/usr/bin/env python3
+"""Validación F1B3A con XDG/SQLite privados y mocks loopback; Qt opt-in."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import time
+import sys
+sys.dont_write_bytecode = True
+from validate_f1a import EXTERNAL_TESTS
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qml", action="store_true", help="Flujo QML y ejecutable offscreen (puerto 8765 libre); no Plasma.")
+    args = parser.parse_args()
+    repo = Path(__file__).resolve().parent.parent
+    os.umask(0o077)
+    evidence = Path(tempfile.mkdtemp(prefix="kda-f1b3a-check-"))
+    env = os.environ.copy()
+    for key in list(env):
+        if key.endswith("_API_KEY") or key.upper().endswith("_PROXY") or key in ["KDA_F1B1_CHILD", "KDA_F1B3A_CHILD"]:
+            env.pop(key)
+    for key, directory in [("XDG_CONFIG_HOME", "config"), ("XDG_CACHE_HOME", "cache"), ("XDG_DATA_HOME", "data"), ("TMPDIR", "tmp")]:
+        path = evidence / directory
+        path.mkdir(mode=0o700)
+        env[key] = str(path)
+    env["CARGO_NET_OFFLINE"] = "true"
+    skips = [argument for name in EXTERNAL_TESTS for argument in ["--skip", name]]
+    commands = [
+        ("fmt", ["cargo", "fmt", "--check"]),
+        ("check", ["cargo", "check", "--locked", "--all-targets"]),

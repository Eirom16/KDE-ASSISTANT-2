+        m.status = 200;
+        m.invalid = true;
+    }
+    assert_eq!(
+        connection::probe(&cfg.ai, Duration::from_secs(2))
+            .await
+            .unwrap_err()
+            .category,
+        "protocol"
+    );
+    {
+        let mut m = state.lock().unwrap();
+        m.invalid = false;
+        m.delay = true;
+    }
+    assert_eq!(
+        connection::probe(&cfg.ai, Duration::from_millis(30))
+            .await

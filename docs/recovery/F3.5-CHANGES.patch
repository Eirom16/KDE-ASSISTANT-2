+        "known provider must require explicit approval for a different destination"
+    );
+    assert!(
+        state.lock().unwrap().requests.is_empty(),
+        "no credential may cross before approval"
+    );
+    cfg.ai
+        .provider_endpoint_approvals
+        .insert("groq".into(), cfg.ai.base_url.clone());
+    connection::models(&cfg.ai, Duration::from_secs(2))
+        .await
+        .unwrap();
+    assert_eq!(state.lock().unwrap().requests.len(), 1);
+    cfg.ai.base_url.push_str("/changed");
+    assert_eq!(
+        connection::models(&cfg.ai, Duration::from_secs(2))
+            .await
+            .unwrap_err()
+            .category,
+        "untrusted_endpoint"
+    );
+    assert_eq!(state.lock().unwrap().requests.len(), 1);
+    server.abort();
+}
+
+#[tokio::test]
+async fn f35_audit_probe_rejects_malformed_choice_and_terminal_sequences() {
+    for data in [
+        r#"{"choices":[{"index":"not-an-index","delta":{"content":"OK"}}]}"#,
+        r#"{"choices":[{"delta":{"content":"OK","tool_calls":"malformed"}}]}"#,
+    ] {
+        let app = Router::new()
+            .route(
+                "/v1/models",
+                get(|| async { Json(json!({"data":[{"id":"fixture-chat"}]})) }),
+            )
+            .route(
+                "/v1/chat/completions",
+                post(move || async move { format!("data: {data}\n\ndata: [DONE]\n\n") }),
+            );
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let mut cfg = Config::first_run();
+        cfg.ai.provider = "custom".into();
+        cfg.ai.base_url = format!("http://{}/v1", listener.local_addr().unwrap());
+        cfg.ai.api_key = "synthetic-loopback-only".into();
+        cfg.ai.model = "fixture-chat".into();
+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        let result = connection::probe(&cfg.ai, Duration::from_secs(2)).await;
+        assert!(
+            result.is_err(),
+            "malformed SSE choices are not a successful diagnostic"
+        );
+        server.abort();
+    }
+}
+
+#[tokio::test]
+async fn f35_audit_stt_does_not_log_remote_body_or_retry_billing() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let count = Arc::new(AtomicUsize::new(0));
+    let requests = count.clone();
+    let app = Router::new().route(
+        "/v1/audio/transcriptions",
+        post(move || {
+            let requests = requests.clone();
+            async move {
+                requests.fetch_add(1, Ordering::SeqCst);
+                (
+                    StatusCode::TOO_MANY_REQUESTS,
+                    Json(json!({"error":{"message":"SYNTHETIC_STT_SECRET_ECHO"}})),
+                )
+            }
+        }),
+    );
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let client = kde_assistant_lib::backend::stt_api::SttApiClient::new(
+        format!("http://{}/v1", listener.local_addr().unwrap()),
+        "synthetic-stt-only".into(),
+        "fixture-stt".into(),
+    )
+    .unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let error = client.transcribe(&[0.0; 16], None).await.unwrap_err();
+    assert!(!error.to_string().contains("SYNTHETIC_STT_SECRET_ECHO"));
+    assert_eq!(count.load(Ordering::SeqCst), 1);
+    server.abort();
+}
+
+#[test]
+fn f35_audit_switch_does_not_borrow_another_profiles_flat_values() {
+    let mut cfg = Config::first_run();
+    cfg.ai.migrate_profiles();
+    cfg.ai.provider = "groq".into();
+    assert_eq!(
+        cfg.ai.effective_base_url(),
+        "https://api.groq.com/openai/v1"
+    );
+    assert!(cfg.ai.effective_model().is_empty());
+}
+
+#[test]
+fn f35_audit_legacy_duplicate_cannot_cross_provider_or_revive_deletion() {
+    let mut cfg = Config::first_run();
+    cfg.ai.provider = "groq".into();
+    cfg.ai.api_key = "synthetic-old-openrouter".into();
+    cfg.ai
+        .provider_keys
+        .insert("openrouter".into(), "synthetic-old-openrouter".into());
+    cfg.ai.provider_keys.insert("groq".into(), String::new());
+    cfg.ai.migrate_profiles();
+    assert!(
+        cfg.ai.effective_api_key().is_empty(),
+        "a legacy duplicate from another profile must never replace the tombstone"
+    );
+    assert_eq!(
+        cfg.ai.provider_keys["openrouter"],
+        "synthetic-old-openrouter"
+    );
+}
+
+#[tokio::test]
+async fn f35_audit_redirect_never_reaches_another_origin_and_response_is_bounded() {
+    let (target, state, target_task) = mock().await;
+    let destination = format!("{target}/models");
+    let app =
+        Router::new()
+            .route(
+                "/v1/models",
+                get(move || async move {
+                    (StatusCode::TEMPORARY_REDIRECT, [("location", destination)])
+                }),
+            )
+            .route(
+                "/large/models",
+                get(|| async { "x".repeat(2 * 1024 * 1024 + 1) }),
+            );
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let origin = format!("http://{}", listener.local_addr().unwrap());
+    let task = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let mut cfg = Config::first_run();
+    cfg.ai.provider = "custom".into();
+    cfg.ai.api_key = "synthetic-loopback-redirect-only".into();
+    cfg.ai.base_url = format!("{origin}/v1");
+    assert_eq!(
+        connection::models(&cfg.ai, Duration::from_secs(2))
+            .await
+            .unwrap_err()
+            .category,
+        "redirect"
+    );
+    assert!(state.lock().unwrap().requests.is_empty());
+    cfg.ai.base_url = format!("{origin}/large");
+    assert_eq!(
+        connection::models(&cfg.ai, Duration::from_secs(2))
+            .await
+            .unwrap_err()
+            .category,
+        "protocol"
+    );
+    task.abort();
+    target_task.abort();
+}
diff --git a/tests/qml/F35Runtime.qmlpart b/tests/qml/F35Runtime.qmlpart
new file mode 100644
index 0000000000000000000000000000000000000000..e3ee148efcb5e4835a077457ddc15881ab5f8162
--- /dev/null
+++ b/tests/qml/F35Runtime.qmlpart
@@ -0,0 +1,42 @@
+// Injected only into a private copy of Main.qml by validate_f35.py.
+property bool f35Saved: false
+property int f35Phase: 0
+function f35Find(item, name) {
+    if (item.objectName === name) return item
+    for (var i=0;i<item.children.length;i++) { var found=f35Find(item.children[i],name); if(found) return found }
+    return null
+}
+function f35Fail() { console.error("F35_UI_FAIL phase="+f35Phase); Qt.exit(1) }
+Connections { target: settings; function onSaved() { root.f35Saved=true } }
+Timer {
+    interval:100; repeat:true; running:root.f35Phase < 4
+    property int ticks:0
+    onTriggered: {
+        ticks++
+        if(ticks>180) { root.f35Fail(); return }
+        if(root.f35Phase===0 && root.backendOnline) {
+            root.width=1000; root.height=740
+            settings.show(); settings.activeTab="ia"; root.f35Phase=1
+        } else if(root.f35Phase===1 && settings.loaded && !settings.busy) {
+            if("F35_MODE"==="save") {
+                settings.switchProvider("groq")
+                root.f35Find(settings,"settingsBaseUrl").value="F35_PROVIDER"
+                root.f35Find(settings,"settingsModel").editText="fixture-chat"
+                root.f35Find(settings,"settingsApiKey").value="synthetic-f35-not-a-real-key"
+                settings.approveEndpoint()
+                settings.saveConfig(); root.f35Phase=2
+            } else {
+                var ai=settings.rawConfig.ai
+                if(settings.provider!=="groq" || ai.base_url!=="F35_PROVIDER" || ai.model!=="fixture-chat" || ai.credential_states.groq!=="stored" || root.f35Find(settings,"settingsApiKey").value!=="") {root.f35Fail();return}
+                console.log("F35_UI_RESTART_PASS provider,url,model,masked_credential")
+                root.f35Phase=4
+            }
+        } else if(root.f35Phase===2 && root.f35Saved && !settings.busy) {
+            settings.hide(); settings.show(); root.f35Phase=3
+        } else if(root.f35Phase===3 && settings.loaded && !settings.busy) {
+            if(settings.rawConfig.ai.credential_states.groq!=="stored") {root.f35Fail();return}
+            console.log("F35_UI_SAVE_PASS server_ack,close,reopen,masked_credential")
+            root.f35Phase=4
+        }
+    }
+}
diff --git a/tests/qml/tst_f35_settings.qml b/tests/qml/tst_f35_settings.qml

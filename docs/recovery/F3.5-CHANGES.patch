+        (404, "", "not_found"),
+        (429, "", "rate_limit"),
+        (429, "insufficient_quota", "quota"),
+        (402, "", "quota"),
+        (500, "", "provider_unavailable"),
+        (503, "", "provider_unavailable"),
+        (400, "", "parameters"),
+        (302, "", "redirect"),
+    ] {
+        {
+            let mut m = state.lock().unwrap();
+            m.status = status;
+            m.code = code.into();
+            m.requests.clear();
+        }

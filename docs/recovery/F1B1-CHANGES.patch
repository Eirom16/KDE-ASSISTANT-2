+        assert_eq!(
+            c.post(format!("{base}/api/config"))
+                .header("Host", "localhost:8765")
+                .bearer_auth(&token)
+                .json(&public)
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            200
+        );
+        let session: Value = c
+            .post(format!("{base}/api/session"))
